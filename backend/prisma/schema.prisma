// PRISMA CLIENT GENERATOR - Prisma Client is the ORM API we use in backend code.

generator client {
  provider = "prisma-client-js"
}

// DATABASE CONNECTION CONFIGURATION

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  FUND_TRANSFER
}

enum TransactionMode {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionChannel {
  BRANCH
  ATM
  INTERNET_BANKING
  MOBILE_BANKING
}

enum AuditModule {
  AUTH
  CUSTOMER
  ACCOUNT
  TRANSACTION
  DASHBOARD
}

enum AuditAction {
  SIGNUP
  LOGIN
  CREATE_CUSTOMER
  UPDATE_CUSTOMER
  DELETE_CUSTOMER
  APPROVE_CUSTOMER
  REJECT_CUSTOMER
  CREATE_ACCOUNT
  UPDATE_ACCOUNT
  DELETE_ACCOUNT
  DEPOSIT
  WITHDRAW
  FUND_TRANSFER
  VIEW_CUSTOMER_DASHBOARD
  VIEW_ADMIN_DASHBOARD
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum NotificationType {
  USER
  CUSTOMER
  ACCOUNT
  TRANSACTION
  SYSTEM
}

model User {
  id           String     @id @default(uuid())
  userNumber   String     @unique
  name         String
  email        String     @unique
  password     String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)

  customer Customer?
  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String         @id @default(uuid())
  customerNumber String         @unique
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  phoneNumber    String?
  address        String?
  dateOfBirth    DateTime?
  status         CustomerStatus @default(ACTIVE)
  accounts       Account[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  branchName    String
  ifscCode      String
  accountType   AccountType
  balance       Decimal       @default(0.00) @db.Decimal(15, 2)
  currency      String        @default("INR")
  status        AccountStatus @default(ACTIVE)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Transaction {
  id                        String             @id @default(uuid())
  transactionReference      String
  accountId                 String
  account                   Account            @relation(fields: [accountId], references: [id])
  accountNumber             String
  counterpartyAccountNumber String?
  transactionType           TransactionType
  transactionMode           TransactionMode
  transactionChannel        TransactionChannel
  amount                    Decimal            @db.Decimal(15, 2)
  openingBalance            Decimal            @db.Decimal(15, 2)
  closingBalance            Decimal            @db.Decimal(15, 2)
  status                    TransactionStatus
  remarks                   String?
  sourceReference           String?
  createdAt                 DateTime           @default(now())

  @@index([transactionReference])
  @@index([accountNumber])
}

model AuditLog {
  id              String      @id @default(uuid())
  auditReference  String      @unique
  userNumber      String
  userRole        Role
  module          AuditModule
  action          AuditAction
  entityReference String?
  status          AuditStatus
  description     String
  createdAt       DateTime    @default(now())

  @@index([userNumber])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id                    String           @id @default(uuid())
  notificationReference String           @unique
  userId                String
  title                 String
  message               String
  type                  NotificationType
  isRead                Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Employee {
  id             String   @id @default(uuid())
  employeeNumber String   @unique
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  department     String?
  designation    String?
  branchName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
